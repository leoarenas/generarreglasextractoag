GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Fuente local recomendada. Ambas variables son obligatorias en este modo.
SOURCE_FILE=
PROFILE_FILE=
# Solo para PDFs protegidos. No guardar esta clave dentro del perfil.
PDF_PASSWORD=

# Origen automatico desde una carpeta de Google Drive.
# Si se configura, tiene prioridad sobre SOURCE_FILE.
DRIVE_FOLDER_ID=
DRIVE_FILE_PATTERN=*
DRIVE_CACHE_DIR=.cache/drive

# Configuracion multibanco. Si se define, reemplaza DRIVE_FOLDER_ID.
DRIVE_SOURCES_FILE=config/drive_sources.json
MACRO_PDF_PASSWORD=

# Fuente Google Sheets heredada. Se usa si no se configura una fuente local.
SOURCE_SPREADSHEET_ID=
SOURCE_SHEET_NAME=Hoja 1

RULES_SPREADSHEET_ID=
RULES_SHEET_NAME=Reglas

# Destino principal de reglas activas en SQL Server.
SQL_PUBLISH_ENABLED=true
SQL_SERVER=vm-srv-sqldev,1433
SQL_DATABASE=Metalnor_Paralelo
SQL_USERNAME=
SQL_PASSWORD=
SQL_RULES_TABLE=dbo.bank_pattern_rules
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true

POLL_INTERVAL_SECONDS=900
RUN_ONCE=true
DRY_RUN=false
LOG_LEVEL=INFO

LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

BANK_CODE=macro
OUTPUT_DIR=output
STATE_FILE=state.json
MIN_CONFIDENCE_AUTOPUBLISH=0.85
MAX_SAMPLE_ROWS=120
MAX_RULES=30
